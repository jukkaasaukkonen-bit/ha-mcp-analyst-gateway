#!/usr/bin/with-contenv bashio
set -euo pipefail
KEY="$(bashio::config 'tailscale_auth_key')"
HOST="$(bashio::config 'tailscale_hostname')"
BACKEND="$(bashio::config 'backend_url')"
PORT="$(bashio::config 'funnel_port')"
PUBLIC="$(bashio::config 'enable_public_funnel')"

if [ -z "$KEY" ]; then
  bashio::log.warning "No Tailscale auth key configured. Gateway not published."
  exec sleep infinity
fi

# Restrict upstream to Home Assistant's MCP endpoint; no arbitrary upstream paths.
case "$BACKEND" in
  http://homeassistant:8123/api/mcp|http://supervisor/core/api/mcp) ;;
  *) bashio::log.fatal "backend_url must be a supported internal Home Assistant MCP endpoint"; exit 1 ;;
esac

for i in $(seq 1 60); do
  tailscale status --json >/dev/null 2>&1 && break
  sleep 1
done
if ! tailscale status --json 2>/dev/null | jq -e '.BackendState == "Running"' >/dev/null 2>&1; then
  tailscale up --auth-key="$KEY" --hostname="$HOST" --accept-dns=false --accept-routes=false
fi

# Resolve the configured backend only from a strict allowlist.
case "$BACKEND" in
  http://homeassistant:8123/api/mcp)
    UPSTREAM="http://homeassistant:8123/api/mcp"
    HOST_HEADER="homeassistant:8123"
    ;;
  http://supervisor/core/api/mcp)
    UPSTREAM="http://supervisor/core/api/mcp"
    HOST_HEADER="supervisor"
    ;;
esac

cat > /etc/nginx/http.d/default.conf <<NGINX
server {
    listen 127.0.0.1:8787;
    server_name _;
    client_max_body_size 2m;
    location = /api/mcp {
        proxy_pass ${UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host ${HOST_HEADER};
        proxy_set_header Authorization \$http_authorization;
        proxy_set_header Accept \$http_accept;
        proxy_set_header Content-Type \$content_type;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_set_header X-Supervisor-Token "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
    location / { return 404; }
}
NGINX
nginx -t
nginx

# No public exposure in diagnostic release. Explicitly refuse unsafe configuration.
if [ "$PUBLIC" = "true" ]; then
  bashio::log.fatal "PUBLIC FUNNEL BLOCKED in v0.2.3: authenticated MCP client flow not yet validated. Set enable_public_funnel=false."
  exit 1
fi
bashio::log.info "Funnel OFF: starting read-only diagnostic checks."
/usr/local/bin/gateway-diagnostics.sh "$BACKEND"
bashio::log.info "Gateway started with public exposure disabled."


while sleep 30; do
  pgrep nginx >/dev/null || exit 1
done
